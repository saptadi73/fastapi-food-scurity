APP_NAME="Food Safety Operating System"
ENVIRONMENT=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO
# Backend CORS hanya aktif saat ENVIRONMENT=development/testing. Production ditangani NGINX.
CORS_ORIGINS=["http://localhost:5173"]
# Isi setelah PostgreSQL 18 + PostGIS tersedia. Jangan commit kredensial.
# DATABASE_URL=postgresql+asyncpg://fsos:YOUR_PASSWORD@localhost:5432/fsos
DATABASE_URL=
# Koneksi owner untuk migrasi, seed, provisioning dan maintenance; jangan diberikan ke proses API production.
ADMIN_DATABASE_URL=
READINESS_TIMEOUT_SECONDS=3
REDIS_URL=redis://localhost:6379/0
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Isi secret acak sebelum mengimplementasikan autentikasi.
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
GOOGLE_MAP_API_KEY=
OPENAI_API_KEY=

